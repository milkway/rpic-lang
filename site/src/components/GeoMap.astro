---
// A pic drawing on a real map: the repo file is georeferenced at build time
// (`rpic --geojson`, the same binary that renders the figures) and the
// FeatureCollection is handed to MapLibre GL JS in the browser through the
// shared `lib/geomap.ts` (styling from simplestyle + `geopic:*`, sizes true
// to the ground — see the comments there).
import { renderGeoFile } from '../lib/rpic';

interface Props {
  /** repo-relative .pic path (georeferenced beside its own dir) */
  src: string;
  caption?: string;
  /** map height, CSS length (default 22rem) */
  height?: string;
}
const { src, caption, height = '22rem' } = Astro.props;
const geojson = renderGeoFile(src);
---

<figure class="not-prose my-6">
  <div
    class="geomap rounded-lg border border-slate-200 dark:border-slate-700 overflow-hidden bg-slate-50"
    style={`height:${height}`}
    data-geojson={JSON.stringify(geojson)}
  ></div>
  {caption && (
    <figcaption class="text-center text-[13px] text-slate-500 dark:text-slate-400 mt-2">{caption}</figcaption>
  )}
</figure>

<style is:global>
  .geomap .maplibregl-popup-content {
    font: 12px/1.4 ui-sans-serif, system-ui, sans-serif;
    padding: 8px 10px;
    color: #0f172a;
  }
</style>

<script>
  // all the map logic (basemap, layers, ground-true sizes, popups) lives in
  // the shared client module, also driving the live playground
  import { createGeoMap, type GeoFC } from '../lib/geomap';

  for (const el of document.querySelectorAll<HTMLElement>('.geomap')) {
    const fc = JSON.parse(el.dataset.geojson ?? '{"type":"FeatureCollection","features":[]}') as GeoFC;
    const map = createGeoMap(el);
    map.setGeoJSON(fc);
    map.fitTo(fc);
  }
</script>
